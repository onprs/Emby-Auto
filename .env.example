# Local development only. Replace every production value.
POSTGRES_USER=emby_auto
POSTGRES_PASSWORD=emby_auto
POSTGRES_DB=emby_auto
POSTGRES_PORT=15432
DATABASE_URL=postgres://emby_auto:emby_auto@127.0.0.1:15432/emby_auto?sslmode=disable
BOOTSTRAP_CONFIG_PATH=../runtime/bootstrap.json
API_ADDRESS=127.0.0.1:8080
DATABASE_CONNECT_TIMEOUT=5s
# 单次安装初始化（迁移、建档与运行时激活）的总时长上限；过小会截断慢迁移，可重试。
SETUP_INITIALIZE_TIMEOUT=10m
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
SESSION_TTL=168h
SESSION_COOKIE_SECURE=false

# 反向代理网段；只有来自这些网段的请求才采信 X-Forwarded-For。
# 留空时默认信任回环网段 127.0.0.0/8,::1/128；其它来源按 TCP 对端地址计数。
TRUSTED_PROXY_CIDRS=

# 留空时由首次安装向导生成。部署方也可注入独立的 32 字节 Base64 密钥。
CONFIG_ENCRYPTION_KEY=

RIVER_GENERAL_WORKERS=10
RIVER_TRANSCODE_WORKERS=1
OPERATION_HEARTBEAT_INTERVAL=10s
DOWNLOAD_SYNC_INTERVAL=15s
RSS_SCHEDULE_CONCURRENCY=4

# Worker imports must use the Emby media owner's non-root UID. Generic Docker
# deployment sets this from APP_UID; host-integrated deployments may instead
# configure EMBY_AUTO_HOST_CONTROL_EXECUTABLE.
# When set, the API also reads real host network counters through this
# executable; without it, network charts fall back to in-container counters.
EMBY_MEDIA_OWNER_UID=1000
# EMBY_AUTO_HOST_CONTROL_EXECUTABLE=/absolute/path/to/host-control
