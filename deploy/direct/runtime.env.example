# Copy to /etc/emby-auto/runtime.env with owner=root:emby and mode=0640.
# 复制到 /etc/emby-auto/runtime.env，并设置 owner=root:emby、mode=0640。
# When the media owner is not emby, update User/Group in both systemd units too.
# 如果媒体 owner 不是 emby，还要同时修改两个 systemd unit 的 User/Group。
API_ADDRESS=127.0.0.1:18081
BOOTSTRAP_CONFIG_PATH=/var/lib/emby-auto/bootstrap.json
DATABASE_CONNECT_TIMEOUT=5s
SHUTDOWN_TIMEOUT=30s
LOG_LEVEL=info
SESSION_TTL=168h
SESSION_COOKIE_SECURE=false

RIVER_GENERAL_WORKERS=10
RIVER_TRANSCODE_WORKERS=1
OPERATION_HEARTBEAT_INTERVAL=10s
DOWNLOAD_SYNC_INTERVAL=15s
RSS_SCHEDULE_CONCURRENCY=4

# Replace this with the non-root media-owner UID, such as the output of `id -u emby`.
# 必须替换为实际媒体 owner 的非 root UID，例如 `id -u emby` 的输出。
EMBY_MEDIA_OWNER_UID=1000

# By default, the first-run wizard writes the database connection and generated
# encryption key to bootstrap.json. Explicit injection is supported before setup,
# but real values must never be committed to Git.
# 默认由首次安装向导把数据库连接和生成的配置加密密钥写入 bootstrap.json；
# 也可在安装前显式注入，但不得把真实值提交到 Git。
# DATABASE_URL=
# CONFIG_ENCRYPTION_KEY=
