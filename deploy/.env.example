# 复制为 deploy/.env 后再修改。不要提交真实值。
EMBY_AUTO_IMAGE_TAG=local
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# 后端镜像中的非 root 用户必须与 Emby 媒体文件 owner 一致。
# Linux 可通过 `id -u emby` 和 `id -g emby` 查询。
APP_UID=10001
APP_GID=10001

POSTGRES_USER=emby_auto
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=emby_auto

# 以下目录必须使用绝对路径、预先创建，并允许 APP_UID/APP_GID 读写。
# 为保证 qBittorrent、Emby 与 Worker 对路径的理解一致，容器内外使用同一路径。
DOWNLOAD_ROOT=/srv/emby-auto/downloads
WORK_ROOT=/srv/emby-auto/work
STAGING_ROOT=/srv/emby-auto/staging
ANIME_LIBRARY_ROOT=/srv/emby-auto/media/anime
MOVIE_LIBRARY_ROOT=/srv/emby-auto/media/movies

# 仅当外层反向代理已提供 HTTPS 时设为 true。
SESSION_COOKIE_SECURE=false
SESSION_TTL=168h
LOG_LEVEL=info

RIVER_GENERAL_WORKERS=10
RIVER_TRANSCODE_WORKERS=1
OPERATION_HEARTBEAT_INTERVAL=10s
DOWNLOAD_SYNC_INTERVAL=15s
RSS_SCHEDULE_CONCURRENCY=4
